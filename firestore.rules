rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Secure user profiles (PII Isolation: email data is private to the owner)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket list prohibited to prevent scraping
      
      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().uid == userId &&
        incoming().email is string &&
        incoming().email.size() <= 256;

      allow update: if isOwner(userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email;

      allow delete: if false;
    }

    // Secure interventions & student notes
    match /interventions/{interventionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(interventionId) &&
        incoming().authorId == request.auth.uid &&
        incoming().content is string &&
        incoming().content.size() <= 2048;
      allow update, delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }

    // Secure direct messages & replies between faculty and students
    match /direct_messages/{messageId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(messageId);
      allow delete: if isSignedIn();
    }

    // Secure import audits for authorized faculty and administrators
    match /import_audits/{importId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(importId);
      allow delete: if false;
    }

    // Verified student communication practice records (Part D & E)
    match /practice_records/{recordId} {
      allow get: if isSignedIn() && (existing().studentId == request.auth.uid || isOwner(existing().studentId));
      allow list: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(recordId) &&
        incoming().studentId == request.auth.uid &&
        incoming().category is string;
      allow update: if isSignedIn() && existing().studentId == request.auth.uid;
      allow delete: if isSignedIn() && existing().studentId == request.auth.uid;
    }

    // Grounded educational resources in the Evolyn Knowledge repository (Part B & E)
    match /educational_resources/{resourceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(resourceId);
    }

    // Live practice rooms state & metadata (Part C & E)
    match /live_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId) && incoming().hostId == request.auth.uid;
      allow update: if isSignedIn() && (existing().hostId == request.auth.uid || incoming().diff(existing()).affectedKeys().hasOnly(['participants', 'status']));
      allow delete: if isSignedIn() && existing().hostId == request.auth.uid;
    }
  }
}
